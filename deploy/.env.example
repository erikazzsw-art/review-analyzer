# 线上 ECS 部署环境变量模板（docker-compose.yml 读取）
# 用法：cp deploy/.env.example deploy/.env 后填入真实值。deploy/.env 已被 .gitignore 挡住，禁止提交真实值。

# ── LLM ──────────────────────────────────────────────
# DeepSeek API
DEEPSEEK_API_KEY=sk-<YOUR_DEEPSEEK_KEY>
# OpenAI API（用于 embedding / GPT-4o-mini 分析）
OPENAI_API_KEY=sk-<YOUR_OPENAI_KEY>

# ── 加密 / 会话 ──────────────────────────────────────
AES_SECRET_KEY=<FERNET_KEY_BASE64>
API_SESSION_SECRET=<RANDOM_64_HEX>

# ── Paddle 计费 ──────────────────────────────────────
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=<PADDLE_CLIENT_TOKEN>
PADDLE_API_KEY=<PADDLE_API_KEY>
PADDLE_ENVIRONMENT=sandbox
NEXT_PUBLIC_PADDLE_ENV=sandbox
PADDLE_WEBHOOK_SECRET=<PADDLE_WEBHOOK_SECRET>

# Price IDs — 各 tier × period
PADDLE_PRICE_ID=<PRICE_ID>
PADDLE_STARTER_PRICE_ID=<PRICE_ID>
PADDLE_STARTER_YEARLY_PRICE_ID=<PRICE_ID>
PADDLE_PRO_YEARLY_PRICE_ID=<PRICE_ID>
PADDLE_TEAM_PRICE_ID=<PRICE_ID>
PADDLE_TEAM_YEARLY_PRICE_ID=<PRICE_ID>

# ── 数据源 ───────────────────────────────────────────
SHULEX_API_KEY=<SHULEX_API_KEY>
APIFY_API_TOKEN=<APIFY_API_TOKEN>
# woot.com 抓取仅限国内环境（US marketplace only，~50 条/ASIN）。
# 出海 prod 保持 false；设为 true 才启用 woot 抓取兜底。
ENABLE_WOOT_SCRAPER=false

# ── 数据库 ───────────────────────────────────────────
DATABASE_URL=postgresql://postgres.<REF>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:6543/postgres

# ── 通知 / 邮件 ──────────────────────────────────────
FEISHU_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/<TOKEN>
RESEND_API_KEY=<RESEND_API_KEY>
DEPLOY_NOTIFY_EMAIL=<notify@example.com>

# ── TLS / 证书 ───────────────────────────────────────
LETSENCRYPT_EMAIL=<admin@example.com>

# ── CD 部署（GitHub Actions 用；本地/ECS 无需填） ────
ECS_HOST=<ECS_PUBLIC_IP>
ECS_USER=<ssh_user>
ECS_SSH_KEY=<PRIVATE_KEY_PEM>
ECS_DEPLOY_PATH=/opt/clueai/deploy
